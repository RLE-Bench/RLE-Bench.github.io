{
  "name": "rlebench-submissions",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-assets.mjs",
    "precheck": "node scripts/sync-assets.mjs",
    "predeploy": "node scripts/sync-assets.mjs",
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787 --var APP_ORIGIN:http://127.0.0.1:8787",
    "test": "node --test test/*.test.mjs",
    "db:local": "wrangler d1 migrations apply rlebench-submissions --local",
    "db:remote": "wrangler d1 migrations apply rlebench-submissions --remote",
    "check": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.131.1"
  }
}
